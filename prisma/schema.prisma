datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Goal {
  id        String   @id @default("default-goal")
  amount    Float    @default(5000.0)
  startDate String?
  startTime String?
  endDate   String?
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id        String   @id @default(uuid())
  taskName  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
